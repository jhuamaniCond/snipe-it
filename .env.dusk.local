# Entorno EXCLUSIVO para pruebas E2E con Laravel Dusk.
# Dusk lo usa al ejecutar `php artisan dusk` (respalda tu .env y usa este).
# Sirve el servidor con: php artisan serve --env=dusk.local
#
# BD: SQLite de archivo (database/database.sqlite) — dedicada y aislada de la
# MariaDB de Docker (tus datos demo NO se tocan). Dusk trunca esta BD entre pruebas.

APP_ENV=dusk.local
APP_DEBUG=true
APP_KEY=base64:3ilviXqB9u6DX1NRcyWGJ+sjySF+H18CPDGb3+IVwMQ=
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_LOCALE=en-US

DB_CONNECTION=sqlite
# La conexión 'sqlite' apunta de forma fija a database/database.sqlite

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local_public
